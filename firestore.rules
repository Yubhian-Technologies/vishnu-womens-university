rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Public collections — anyone can read, only logged-in admin can write.
    // When adding a new Firestore-backed section, add its collection name
    // here too — otherwise reads are denied by default (including for
    // logged-in admins; Firestore's local-cache optimism can make a freshly
    // added doc appear to work in the admin UI even when the underlying read
    // is actually blocked, which is misleading during testing).
    match /{collection}/{docId} {
      allow read: if collection in [
        'banners', 'news', 'gallery', 'programs',
        'faculty', 'placements', 'announcements',
        'givingLevels', 'alumniImpact', 'alumniStories',
        'alumniEvents', 'alumniCompanies',
        'governingBody', 'coreExecutives',
        'academicCalendar', 'holidays', 'events',
        'faqs', 'studentClubs', 'jobOpenings',
        'contentBlocks', 'contacts', 'svesCampuses', 'downloads', 'curriculum'
      ];
      allow write: if request.auth != null;
    }

  }
}
