rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Public collections — anyone can read, only logged-in admin can write.
    // When adding a new Firestore-backed section, add its collection name
    // here too — otherwise reads are denied by default (including for
    // logged-in admins; Firestore's local-cache optimism can make a freshly
    // added doc appear to work in the admin UI even when the underlying read
    // is actually blocked, which is misleading during testing).
    match /{collection}/{docId} {
      allow read: if collection in [
        'banners', 'news', 'gallery', 'programs',
        'faculty', 'announcements',
        'givingLevels', 'alumniImpact', 'alumniStories',
        'alumniEvents', 'alumniCompanies',
        'governingBody', 'coreExecutives',
        'academicCalendar', 'holidays', 'events',
        'faqs', 'studentClubs', 'jobOpenings',
        'contentBlocks', 'contacts', 'svesCampuses', 'downloads', 'curriculum',
        'sitePhotos', 'navLinkOverrides', 'governanceItems', 'differentiatorItems',
        'placementItems', 'happenings', 'awards', 'researchItems', 'complianceDocs',
        'institutionalPolicies', 'placementYears', 'tpoTeamPhotos', 'iloOfficePhotos', 'gsacPhotos',
        'iicMemberPhotos', 'tedxSvecwPhotos', 'tiDspGalleryPhotos',
        'chipsToStartupActivityPhotos', 'chipsToStartupOutcomePhotos'
      ];
      allow write: if request.auth != null;
    }

    // Public form submissions (Contact Us, Careers application) — anyone
    // (including signed-out visitors) can submit a new entry, but only a
    // logged-in admin can read, update (e.g. mark as read), or delete them,
    // since these collections hold visitor-supplied PII.
    match /contactSubmissions/{docId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    match /careerApplications/{docId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    match /admissionInquiries/{docId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

  }
}
