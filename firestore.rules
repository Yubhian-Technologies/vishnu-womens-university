rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Public collections — anyone can read, only logged-in admin can write.
    // This is a catch-all: ANY collection not explicitly excluded below is
    // publicly readable, so adding a brand-new Firestore-backed section (a
    // new photo gallery, a new differentiators sub-page, whatever comes
    // next) never requires touching this file again. Writes always require
    // auth regardless of collection name, which is the actual security
    // boundary that matters (only the admin panel signs in).
    //
    // The ONLY reason to come back and edit this file in the future is if a
    // new collection holds visitor-submitted PII (like the three below) —
    // in that case, add its name to the exclusion list here AND give it its
    // own explicit match block with the same shape as contactSubmissions.
    match /{collection}/{docId} {
      allow read: if !(collection in ['contactSubmissions', 'careerApplications', 'admissionInquiries']);
      allow write: if request.auth != null;
    }

    // Public form submissions (Contact Us, Careers application, Admissions
    // inquiry) — anyone (including signed-out visitors) can submit a new
    // entry, but only a logged-in admin can read, update (e.g. mark as
    // read), or delete them, since these collections hold visitor-supplied
    // PII (name, email, phone, etc.) that shouldn't be publicly readable.
    match /contactSubmissions/{docId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    match /careerApplications/{docId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    match /admissionInquiries/{docId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

  }
}
